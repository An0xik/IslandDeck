<Window x:Class="IslandDeck.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Width="420" Height="150" Title="IslandDeck">
    <Grid>
        <Border x:Name="Pill" Background="Black" CornerRadius="20"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="150" Height="36" Margin="0,6,0,0" ClipToBounds="True"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave">
            <Grid>
                <TextBlock x:Name="CompactText" Foreground="White" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="14,0" />

                <Grid x:Name="Expanded" Opacity="0" Margin="20,12,20,12" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" Text="Nič nehrá" />
                        <TextBlock x:Name="ArtistText" Foreground="#AAAAAA" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Grid Grid.Row="1" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="⏮" Click="Prev_Click" Style="{x:Null}" Width="36" Height="30"
                                    Background="#222" Foreground="White" BorderThickness="0" FontSize="14" />
                            <Button x:Name="PlayBtn" Content="⏵" Click="Play_Click" Style="{x:Null}" Width="44" Height="30"
                                    Margin="6,0" Background="#333" Foreground="White" BorderThickness="0" FontSize="14" />
                            <Button Content="⏭" Click="Next_Click" Style="{x:Null}" Width="36" Height="30"
                                    Background="#222" Foreground="White" BorderThickness="0" FontSize="14" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                            <TextBlock x:Name="BatteryText" Foreground="#AAAAAA" FontSize="11"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
